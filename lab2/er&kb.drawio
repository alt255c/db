  <diagram id="_3M32__nvJwTP7w2c3ut" name="ENUM">
    <mxGraphModel dx="573" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kIpyCfGB_pud-GfCeiyv-4" parent="1" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" value="&lt;div&gt;E1&lt;/div&gt;&lt;div&gt;Формат: кафе, киоск, фуд-корт.&lt;/div&gt;&lt;div&gt;Статус: действующая, закрыта, на ремонте.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E2&lt;/div&gt;&lt;div&gt;Статус: действующий, расторгнут.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E3&lt;/div&gt;&lt;div&gt;Статус: действует, истёк, расторгнут.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E4&lt;/div&gt;&lt;div&gt;Статус: в продаже, снято с продажи.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E5&lt;/div&gt;&lt;div&gt;Статус: в продаже, снята с продажи.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E6&lt;/div&gt;&lt;div&gt;Тип ограничения: запрет сочетания, ограничение количества.&lt;/div&gt;&lt;div&gt;Статус: действует, не действует.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E7&lt;/div&gt;&lt;div&gt;Статус: черновик, действует, архив.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E8&lt;/div&gt;&lt;div&gt;Единица учета: кг, л, шт.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E9&lt;/div&gt;&lt;div&gt;Статус: на хранении, исчерпана, списана.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E10&lt;/div&gt;&lt;div&gt;Статус: отправлена, принята, расхождение.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E11&lt;/div&gt;&lt;div&gt;Статус подтверждения: не подтверждён, подтверждён, отклонён.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E12&lt;/div&gt;&lt;div&gt;Текущий статус: оформлен, готовится, выдан, отменён.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E13&lt;/div&gt;&lt;div&gt;Статус: в заказе, приготовлена, отменена.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E14&lt;/div&gt;&lt;div&gt;Причина: производственное списание, отмена приготовленной позиции, порча, истёк срок.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E15&lt;/div&gt;&lt;div&gt;Вид проверки: плановая, внеплановая.&lt;/div&gt;&lt;div&gt;Результат: пройдена, выявлены нарушения.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;E16&lt;/div&gt;&lt;div&gt;Критичность: низкая, средняя, высокая.&lt;/div&gt;&lt;div&gt;Статус устранения: открыто, в работе, устранено.&lt;/div&gt;" vertex="1">
          <mxGeometry height="800" width="350" x="800" y="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
